#!/bin/bash

# Pre-commit hook to run tests before allowing commits
# This hook runs both Python tests (uv run pytest) and JavaScript tests (npm test:all)

set -e  # Exit on any error

echo "🔍 Running pre-commit tests..."

# Get the current directory (should be the project root)
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"

# Function to print colored output
print_status() {
    local color=$1
    local message=$2
    echo -e "\033[${color}m${message}\033[0m"
}

# Function to run a test command and handle errors
run_test() {
    local test_name=$1
    local test_command=$2
    
    print_status "33" "🧪 Running ${test_name}..."
    
    if eval "$test_command"; then
        print_status "32" "✅ ${test_name} passed!"
    else
        print_status "31" "❌ ${test_name} failed!"
        print_status "31" "💡 Fix the failing tests before committing."
        exit 1
    fi
}

# Check if uv is available
if ! command -v uv &> /dev/null; then
    print_status "31" "❌ Error: uv is not installed or not in PATH"
    print_status "31" "💡 Please install uv: https://docs.astral.sh/uv/getting-started/installation/"
    exit 1
fi

# Check if npm is available
if ! command -v npm &> /dev/null; then
    print_status "31" "❌ Error: npm is not installed or not in PATH"
    print_status "31" "💡 Please install Node.js and npm: https://nodejs.org/"
    exit 1
fi

# Check if we're in the website directory for npm tests
if [ ! -f "website/package.json" ]; then
    print_status "31" "❌ Error: website/package.json not found"
    print_status "31" "💡 Make sure you're running this from the project root"
    exit 1
fi

# Run Python tests with uv
run_test "Python tests (uv run pytest)" "uv run pytest"

# Run JavaScript tests with npm
print_status "33" "🧪 Running JavaScript tests (npm test:all)..."
cd website
if npm run test:all; then
    print_status "32" "✅ JavaScript tests passed!"
else
    print_status "31" "❌ JavaScript tests failed!"
    print_status "31" "💡 Fix the failing tests before committing."
    exit 1
fi
cd ..

print_status "32" "🎉 All tests passed! Proceeding with commit..." 